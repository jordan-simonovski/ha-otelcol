#!/usr/bin/with-contenv bashio
# ==============================================================================
# Render the OpenTelemetry Collector config from add-on options and start it.
# The config is rendered by the shipped `otelcol-config` binary, then layered:
#   1. /etc/otelcol/selfmonitoring.yaml  (static internal pipeline)
#   2. /tmp/otelcol-generated.yaml       (rendered by otelcol-config)
#   3. /tmp/otelcol-override.yaml        (optional raw YAML, wins last)
# ==============================================================================
set -euo pipefail

readonly OPTIONS=/data/options.json
readonly GENERATED=/tmp/otelcol-generated.yaml
readonly OVERRIDE=/tmp/otelcol-override.yaml
readonly GEN_STDERR=/tmp/otelcol-config.stderr

opt() { jq -r "${1} // empty" "${OPTIONS}"; }

# Honour an optional log_level so the rendered-config dump (and bashio output)
# can be silenced at the default level and surfaced on demand.
log_level="$(opt '.log_level')"
[ -n "${log_level}" ] && bashio::log.level "${log_level}"

bashio::log.info "Rendering OpenTelemetry Collector configuration..."

# Generate the middle config layer. A non-zero exit is fatal: the collector
# cannot start without a config. Generator diagnostics go to stderr; surface
# them in the add-on log.
if ! /usr/bin/otelcol-config "${OPTIONS}" > "${GENERATED}" 2> "${GEN_STDERR}"; then
    bashio::log.error "Configuration generation failed:"
    while IFS= read -r line; do
        bashio::log.error "${line}"
    done < "${GEN_STDERR}"
    exit 1
fi
while IFS= read -r line; do
    [ -n "${line}" ] && bashio::log.info "${line}"
done < "${GEN_STDERR}"

declare -a config_args=(
    --config=/etc/otelcol/selfmonitoring.yaml
    --config="${GENERATED}"
)

extra_config="$(opt '.extra_config')"
if [ -n "${extra_config}" ]; then
    printf '%s\n' "${extra_config}" > "${OVERRIDE}"
    config_args+=(--config="${OVERRIDE}")
    bashio::log.info "Applying raw config override from add-on options."
fi

# The full rendered config is verbose; emit it only at debug level so a restart
# loop does not spam the log with the same config on every boot.
bashio::log.debug "Generated collector configuration:"
while IFS= read -r line; do
    bashio::log.debug "${line}"
done < "${GENERATED}"

# Test hook: render the layered config, validate it, and exit without starting
# the collector. Lets CI assert every option permutation produces a config the
# collector accepts, with no ports bound, no broker, and no telemetry round-trip.
if [ "${RENDER_ONLY:-}" = "true" ]; then
    bashio::log.info "RENDER_ONLY set; validating rendered configuration."
    exec /usr/bin/otelcol validate "${config_args[@]}"
fi

bashio::log.info "Starting the OpenTelemetry Collector..."
exec /usr/bin/otelcol "${config_args[@]}"
